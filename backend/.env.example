# Copy to a real env and fill in. On Windows CMD you can also set these
# with `set VAR=value` before running the app, or configure them in your host.

# --- Neon PostgreSQL connection (see README for how to get these) ---
DB_URL=jdbc:postgresql://YOUR-HOST.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=your_neon_user
DB_PASSWORD=your_neon_password

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=604800000

# --- CORS: your frontend dev origin(s), comma separated ---
CORS_ORIGINS=http://localhost:5173
